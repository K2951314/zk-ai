# ===========================================================================
# ZK-AI 环境变量（示例文件——复制为 .env 后填写）
#
# .env 已被 git 忽略，切勿提交真实密钥。
# 前缀：任何进程级配置都可以用 ZKAI_<配置名> 覆盖。
#
# ⚠️ 重要：这个文件只放「密钥」和「服务地址」。
#    **模型叫什么名字，不在这里配！** 请改 config/models.yaml：
#      带什么模型  → models[].deployments[].model
#      别名指向谁  → aliases[].targets
#    在 .env 里加 XXX_MODEL=... 是无效的（程序不会读，也不会报错）。
# ===========================================================================

# --------------------------------------------------------------------------
# 进程级配置
# --------------------------------------------------------------------------
# 监听地址：0.0.0.0 = 局域网可访问；仅本机用请改成 127.0.0.1
ZKAI_HOST=0.0.0.0
ZKAI_PORT=8317
# 换端口：改这里后重启；命令行可临时覆盖：scripts\start_gateway.cmd 9000
# 日志级别：DEBUG / INFO / WARNING / ERROR
ZKAI_LOG_LEVEL=INFO
# JSON 结构化日志（每行一个 JSON 对象），接入日志系统时开启
ZKAI_LOG_JSON=false
ZKAI_ENVIRONMENT=development

# 默认 SQLite；用 PostgreSQL 换成：postgresql+asyncpg://用户:密码@主机:5432/zkai
ZKAI_DATABASE_URL=sqlite+aiosqlite:///./data/zkai.db
# 配置文件目录 / 运行时数据目录
ZKAI_CONFIG_DIR=config
ZKAI_DATA_DIR=data

# 保护 /admin/* 接口，生成方式：
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
ZKAI_ADMIN_TOKEN=
# /v1/* 推理面鉴权：设了就要求客户端 Bearer 携带，不设则完全开放。
# 注意：ZKAI_HOST=0.0.0.0 时不设本项 = 局域网任意机器都能烧你的额度！
ZKAI_API_TOKEN=

# 重试 / 超时相关（完整清单见 config/config.example.yaml）
ZKAI_REQUEST_TIMEOUT=120
ZKAI_DEFAULT_MAX_TOKENS=1024

# 凭据冷却（秒）：分钟级 429 指数退避；额度耗尽类 429 平铺长休
ZKAI_RATE_LIMIT_BASE=60
ZKAI_RATE_LIMIT_MAX=900
# 限流阶梯衰减窗口：距上次 429 超过此时长视为新一波，阶梯从头算起
ZKAI_RATE_LIMIT_DECAY=1800
ZKAI_QUOTA_COOLDOWN=1800
ZKAI_QUOTA_COOLDOWN_MAX=14400

# 隐藏思考内容（K3 等思考模型常用英文思考）：true 时正文正常就只发正文
ZKAI_STRIP_REASONING=false

# Anthropic /v1/messages 端点的兜底模型：Claude Code 等客户端发来的
# claude-* 模型名都路由到这个别名（zk-* 别名与真实模型名不受影响）
ZKAI_ANTHROPIC_DEFAULT_MODEL=zk-auto

# 健康检查模式：manual（手动）| startup（启动时）| scheduled（定时）| off（关闭）
ZKAI_HEALTH_CHECK_MODE=startup
# scheduled 模式下的检查间隔（秒）
ZKAI_HEALTH_CHECK_INTERVAL=900

# 设为 false 可禁止在 providers.yaml 里直接写 value: 明文密钥（生产环境建议 false）
ZKAI_ALLOW_INLINE_SECRETS=true

# --------------------------------------------------------------------------
# 供应商密钥（由 config/providers.example.yaml 引用）
#
# 注意：下面每一项填的都是「密钥本身」，providers.yaml 里用环境变量的
# **名字**去引用它，两者不要搞混。
# --------------------------------------------------------------------------
OPENAI_KEY_01=
OPENAI_KEY_02=
# 覆盖接入点（例如走代理、Azure 风格网关，或本地 mock）
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_KEY_01=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

GEMINI_KEY_01=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

OPENROUTER_KEY_01=
OPENROUTER_REFERER=https://github.com/zk-ai
OPENROUTER_TITLE=ZK-AI

# --------------------------------------------------------------------------
# 商汤日日新 SenseNova —— 一把 Key 调 8 个模型（含 Kimi K3 / GLM-5.2）
# 申请：https://platform.sensenova.cn → 控制台 → API Keys（sk- 开头）
# 公测期免费；限流按「滚动 5 小时 + 周」双周期算积分，429 属常态
# --------------------------------------------------------------------------
SENSENOVA_BASE_URL=https://token.sensenova.cn/v1
SENSENOVA_API_KEY=
# 同账户所有 Key 共享额度；第二把只在「单 Key 被限流」时有用，无则留空
SENSENOVA_API_KEY_02=
SENSENOVA_API_KEY_03=
SENSENOVA_API_KEY_04=
SENSENOVA_API_KEY_05=
SENSENOVA_API_KEY_06=
SENSENOVA_API_KEY_07=
SENSENOVA_API_KEY_08=
SENSENOVA_API_KEY_09=


# --------------------------------------------------------------------------
# NVIDIA NIM —— https://build.nvidia.com → Get API Key（nvapi- 开头）
# 调用名必须带厂商前缀，如 nvidia/llama-3.3-nemotron-super-49b-v1
# --------------------------------------------------------------------------
NVIDIA_BASE_URL=https://integrate.api.nvidia.com
NVIDIA_API_KEY=
NVIDIA_API_KEY_02=

# 魔搭社区 ModelScope —— https://modelscope.cn → 访问令牌（ms- 开头）
MODELSCOPE_BASE_URL=https://api-inference.modelscope.cn/v1/
MODELSCOPE_API_KEY=



# --------------------------------------------------------------------------
# Moonshot / Kimi 官方 —— https://platform.moonshot.cn（按量付费，可作兜底）
# kimi-k3 约 ¥20/MTok 输入、¥100/MTok 输出；编程可考虑更便宜的 kimi-k2.7-code
# --------------------------------------------------------------------------
MOONSHOT_API_KEY=

# Ollama 不需要密钥；执行 ollama serve 之后把下面的开关改成 true 即可启用
OLLAMA_BASE_URL=http://127.0.0.1:11434
ZKAI_OLLAMA_ENABLED=false
