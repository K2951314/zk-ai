// ZK-AI：允许网关进程（www-data）管理 zkai / zkai-burner 两个服务。
//
// 背景（2026-10-15 起，2026-10-23 扩到网关）：控制台「重启网关 / 重启消耗器」
// 按钮在服务器上报 `sudo: The "no new privileges" flag is set`。根因有两道锁：
//   1. /etc/sudoers.d/* 授权的是 `ubuntu` 用户，而网关以 `www-data` 运行
//      （zkai.service 里 User=www-data），www-data 根本不在白名单里。
//   2. zkai.service / zkai-burner.service 都带 NoNewPrivileges=true，
//      即使 sudoers 配对了，sudo 也会被 no_new_privs 拦死——sudo 是 setuid。
// 走 polkit 可绕开这两道锁：systemctl 通过 D-Bus 请求 systemd 执行，
// 不经过 sudo、也不需要 setuid。这里只放行 www-data 对这两个 unit 的 manage-units。
//
// ⚠️ 从 SSH 会话 `sudo -u www-data systemctl ...` 测能通过是假象——
//   那个进程带着 ubuntu 的登录会话上下文，polkit 按 active session 放行。
//   服务进程没有会话，必须靠本规则显式放行。
//
// 权限边界：只匹配 zkai / zkai-burner，不含其他 unit；也不含 manage-unit-files
// （那会允许改开机自启，属于更宽的权限，控制台用不到）。
polkit.addRule(function(action, subject) {
    if (action.id !== "org.freedesktop.systemd1.manage-units") {
        return polkit.Result.NOT_HANDLED;
    }
    if (subject.user !== "www-data") {
        return polkit.Result.NOT_HANDLED;
    }
    var unit = action.lookup("unit");
    if (unit !== "zkai.service" && unit !== "zkai"
        && unit !== "zkai-burner.service" && unit !== "zkai-burner") {
        return polkit.Result.NOT_HANDLED;
    }
    var verb = action.lookup("verb");
    if (verb === "start" || verb === "stop" || verb === "restart" || verb === "try-restart") {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
