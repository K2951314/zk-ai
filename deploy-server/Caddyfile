# ── 大众点评评价助手（tandian）─────────────────────────
# 与智能询价共用 https://<IP>，用子路径 + handle 块区分：
#   /tandian/* 与 /api/*  → 反代到 手机端.py（127.0.0.1:<PORT>）
#   /zkai/v1/*            → ZK-AI 网关 API（127.0.0.1:8318，Bearer 精确比对）
#   /zkconsole/ui/*       → ZK-AI 控制台界面（HTML 外壳）
#   /zkconsole/admin/*    → ZK-AI 管理接口（admin token 精确比对）
#   /zkconsole/health     → 控制台探活
# 其余（/、/apps、/admin...）一律反代 8001 智能询价，行为不变。
# 还原智能询价独占：sudo cp /etc/caddy/Caddyfile.sq /etc/caddy/Caddyfile && sudo caddy validate --config /etc/caddy/Caddyfile && sudo systemctl reload caddy
{
	cert_issuer acme {
		profile shortlived
		disable_tlsalpn_challenge
	}
	default_sni 120.53.28.29
}

https://120.53.28.29 {

	# 访问日志只留 tandian 相关，避免把智能询价的量也卷进来
	log {
		output file /var/log/caddy/tandian-access.log {
			roll_size 10MiB
			roll_keep 3
		}
		format json
		level INFO
	}

	# ── ZK-AI 网关（公网入口）──────────────────────────────
	# 只放行 /v1/*（OpenAI 兼容接口）与 /health。/admin/*、/ui/*、/web 永不暴露。
	#
	# 为什么在 Caddy 层就拦：网关自身只对 /v1/chat/completions 校验 token，
	# /v1/models 和 /health 是裸的（本地部署假定，无 token 也返回 200）。
	# 一旦暴露到公网，「列模型 / 探活 / 拿路由拓扑」就变成免费信息。
	# 这里用 env 里的 ZKAI_PUBLIC_TOKEN 做**精确比对**，不是 Bearer 通配——
	# 通配匹配等于任何非空串都能过，拦不住扫描器。
	#
	# 用法（任何地方都能调）：
	#   curl https://120.53.28.29/zkai/v1/chat/completions \
	#     -H "Authorization: Bearer <ZKAI_API_TOKEN>" \
	#     -H "Content-Type: application/json" \
	#     -d '{"model":"zk-auto","messages":[{"role":"user","content":"hi"}]}'
	# ── ZK-AI 网关 API（公网入口）────────────────────────
	# 只放行 /v1/*（OpenAI 兼容接口）与 /health。/admin/* 不走这里，见下面的控制台块。
	@zkai path /zkai/health /zkai/v1 /zkai/v1/*
	handle @zkai {
		@zkai_auth header Authorization "Bearer {$ZKAI_PUBLIC_TOKEN}"
		handle @zkai_auth {
			uri strip_prefix /zkai
			reverse_proxy 127.0.0.1:8318 {
				flush_interval -1
				# 慢请求预算：网关上游可达 300s，且同一请求内会沿候选链重试，
				# 整条链墙钟默认 300s。600s 覆盖它，不让 Caddy 先掐断。
				transport http {
					response_header_timeout 600s
				}
			}
		}
		handle {
			respond "Unauthorized" 401
		}
	}

	# ── ZK-AI 控制台（公网入口）──────────────────────────
	#
	# 控制台 index.html 的 api() 用绝对路径 fetch("/admin/providers")，
	# <base> 对 JS 里的 fetch 无效，所以必须让**裸路径**也达网关。
	# 而 /admin/* 是智能询价自己 mount 的 StaticFiles，它占着；
	# /ui、/v1、/health 它没占用（/ui 在它上面是 404）。
	#
	# 分三类，各自独立鉴权，互不影响：
	#
	#   A. /ui /*、/ui/report/*、/ui/agent/*
	#      控制台 HTML 外壳。外壳零数据（每个值都由 /admin/* 现取），
	#      所以不校验 token —— 否则浏览器首次打开时没有任何请求能带上
	#      token，页面会白屏。登录后位置就是 /ui，页面只在这里做展示。
	#      ⚠️ 这一层不校验，正是因为数据不在这一层。
	#
	#   B. /v1/*、/health
	#      网关 API 与探活。必须带 `Authorization: Bearer <ZKAI_API_TOKEN>`，
	#      Caddy 精确比对（网关自身只校验 chat/completions，/v1/models 和
	#      /health 是裸的，这层补上）。
	#
	#   C. /admin/*（与智能询价共享）
	#      按 token 分流：带正确 admin token → 网关；不带或带错 → 智能询价
	#      （它原有的 /admin 后台行为不变）。Caddy + 网关 require_admin 双保险。
	#
	# 打开 https://120.53.28.29/zkconsole/ui/?token=<ZKAI_ADMIN_TOKEN>
	# 页面把 token 存进本机浏览器 localStorage，之后每个 /admin/* 请求自动带，
	# 由 C 类规则送进网关。不带 token 也能打开页面，但数据接口会 401。
	# （?token= 是网关 index.html 原生支持的直登参数，登录后地址栏会被
	#  replaceState 抹掉，不会留在浏览器历史里。）

	# ---- A. 控制台 HTML 外壳（零数据，不校验）---------------------------
	# /ui 与 /ui/* 是控制台的主地址（智能询价不占用 /ui，实测 404）。
	@zkconsole_ui path /ui /ui/*
	handle @zkconsole_ui {
		reverse_proxy 127.0.0.1:8318 {
			flush_interval -1
		}
	}


	# ---- B. 网关 API /v1/*（必须带 API token）-----------------------------
	@zkai_bare_v1 path /v1 /v1/*
	handle @zkai_bare_v1 {
		@zkai_bare_auth header Authorization "Bearer {$ZKAI_PUBLIC_TOKEN}"
		handle @zkai_bare_auth {
			reverse_proxy 127.0.0.1:8318 {
				flush_interval -1
				transport http {
					response_header_timeout 600s
				}
			}
		}
		handle {
			respond "Unauthorized" 401
		}
	}

	# ---- B2. /health：控制台主页要裸 fetch 它 ---------------------------------
	# index.html 的 loadOverview() 有 fetch("/health").then(r => r.json())，
	# **不带任何凭据**（这是它本来的写法，本地网关 /health 也一直不鉴权）。
	# 给这里加 Bearer 门槛会让它收到 401 纯文本，.json() 抛出
	# "Unexpected token 'U', \"Unauthorized\" is not valid JSON"。
	#
	# 而 /health 又不能完全放行：它带 provider 清单、credential 各状态计数、
	# 模型数、别名、配置告警与 env gap 里的环境变量名，裸奔等于白送拓扑。
	#
	# 折中：带正确 API token，或请求来自控制台页面（Referer/Sec-Fetch 指向
	# /ui），二者其一即放行。Referer 可伪造，但这里只读、无写操作，且拿到
	# 的只是探活快照 —— 真正敏感的数据在 /admin/* 与 /v1/*，那两层不松。
	handle /health {
		@health_tok header Authorization "Bearer {$ZKAI_PUBLIC_TOKEN}"
		@health_from_ui header_regexp Referer ^https?://[^/]+/ui(/|$|\?)
		@health_fetch_ui header Sec-Fetch-Site same-origin
		handle @health_tok {
			reverse_proxy 127.0.0.1:8318 {
				flush_interval -1
			}
		}
		handle @health_from_ui {
			reverse_proxy 127.0.0.1:8318 {
				flush_interval -1
			}
		}
		handle {
			respond "Unauthorized" 401
		}
	}

	# ---- C. /admin/* 分流 ------------------------------------------------
	# /admin/* 是智能询价 app.mount("/admin", StaticFiles) 占着的，但同时
	# 又是控制台 api() 的取数路径（绝对路径 fetch("/admin/providers")）。
	#
	# 关键约束：控制台 api() 自己有 401 语义 —— index.html 里
	#   if (resp.status === 401) { showAuth(); throw ... }
	# 它期待收到 401 后弹登录框。所以不带 token 的请求**必须**由网关应答，
	# 让网关的 require_admin 回 401（本机实测无 token 就是 401）。
	# 一旦把它送去智能询价，那边没这个路由会回 404，登录框永远不弹，
	# 页面表现为「总览空白 + 控制台一片 404」。
	#
	# 那智能询价自己的后台怎么办？它的 /admin/ 是 StaticFiles（html=True），
	# 真实访问是浏览器导航（Accept: text/html），不是 XHR。所以按请求形态分：
	#   - 带正确 admin token                → 网关（控制台取数）
	#   - 不带 token 且是 XHR（fetch 语义）   → 网关（让它回 401 触发登录框）
	#   - 不带 token 且是浏览器导航（HTML）   → 智能询价（保持它原有行为）
	#
	# 判据用 Sec-Fetch-Mode：浏览器地址栏导航/点链接是 navigate，
	# JS fetch()/XHR 是 cors（同源）或 no-cors。curl 请求两个头都不带，
	# 归到 navigate 分支，对运维排查友好（看到的是智能询价的页面而不是 401）。
	handle /admin/* {
		@zk_console_bearer header Authorization "Bearer {$ZKAI_ADMIN_TOKEN_PUBLIC}"
		@zk_console_xadm header X-Admin-Token "{$ZKAI_ADMIN_TOKEN_PUBLIC}"
		@zk_console_xhr header Sec-Fetch-Mode cors
		@zk_console_xhr2 header Sec-Fetch-Mode no-cors
		handle @zk_console_bearer {
			reverse_proxy 127.0.0.1:8318 {
				flush_interval -1
				transport http {
					response_header_timeout 120s
				}
			}
		}
		handle @zk_console_xadm {
			reverse_proxy 127.0.0.1:8318 {
				flush_interval -1
				transport http {
					response_header_timeout 120s
				}
			}
		}
		handle @zk_console_xhr {
			reverse_proxy 127.0.0.1:8318 {
				flush_interval -1
				transport http {
					response_header_timeout 120s
				}
			}
		}
		handle @zk_console_xhr2 {
			reverse_proxy 127.0.0.1:8318 {
				flush_interval -1
				transport http {
					response_header_timeout 120s
				}
			}
		}
		# 浏览器导航（或 curl）：智能询价的 /admin 后台，行为不变
		handle {
			reverse_proxy 127.0.0.1:8001 {
				flush_interval -1
			}
		}
	}

	@tandian path /tandian /tandian/* /api/style /api/write /api/write/* /api/explore /api/job/* /api/history /api/history/*
	handle @tandian {
		uri strip_prefix /tandian
		reverse_proxy 127.0.0.1:8787 {
			flush_interval -1
		}
	}

	# 智能询价：其余全部照旧反代 8001，不记日志（它的量由自己的中间件管）
	handle {
		reverse_proxy 127.0.0.1:8001 {
			flush_interval -1
		}
	}
}