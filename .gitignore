# --- secrets / local configuration -----------------------------------------
.env
.env.*
!.env.example
# ChatGPT / Codex 桌面版期望配置（本地现役，模板 .example.yaml 可提交）
config/chatgpt.yaml
# 一键换机产物：迁移包与导入前备份都可能含全部 Key，绝不进仓库
exports/
imports_backup/
config/config.yaml
config/providers.yaml
config/models.yaml
config/burner.yaml
config/*.local.yaml

# --- runtime data -----------------------------------------------------------
data/*
!data/.gitkeep
*.db
*.db-wal
*.db-shm
*.sqlite3

# --- python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/
.python-version

# --- tooling ----------------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
junit*.xml
.tox/

# --- editors / OS -----------------------------------------------------------
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# --- logs -------------------------------------------------------------------
*.log
logs/
config/*.bak*
.zcode/
# ZCode 编辑器自己的忽略文件（与上面那条 .zcode/ 同属编辑器产物）
.zcodeignore

# --- 设计稿打磨的截图与探针（非交付物，本机看，不入库）----------------------
.mdesign/

# --- agent / 调试产物（非交付物）---------------------------------------------
# WorkBuddy 项目数据（会话记忆等），各机器本地生成，不进仓库
# ⚠ 实际目录名是 `.workbuddy-ai/`（带 -ai）。原来只写了 `.workbuddy/`，
#   匹配不上，于是记忆目录一直以「未跟踪」形式挂在 git status 里、随时可能被
#   误提交（2026-09-29 发现）。两个都写上，避免再踩。
.workbuddy/
.workbuddy-ai/
# 诊断会话留下的临时调试脚本（自带 ruff/mypy 历史错误，去留未定，先排除出提交）
scripts/probe_upstream_path.py

# 一键换机（one-click-migrate 技能）：manifest.toml 要入库（只描述「搬什么」，
# 不含密钥值），其余全是产物——加密包、导入时备份的明文 .env、journal。
# ⚠ 2026-10-01 实测踩到：12MB 的 workspace 加密包（内含全部 API key）落在
#   _bm/ 而忽略规则没覆盖，它一直以未跟踪状态挂在 git status 里，一个
#   git add -A 就会把加密的密钥+数据库提交上去。.migrate 与 *.enc 都要排除。
.migrate/*
!.migrate/manifest.toml
*.enc
_bm/
